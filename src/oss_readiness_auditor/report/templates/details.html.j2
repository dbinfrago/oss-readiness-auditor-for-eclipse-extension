{# oss-readiness-auditor: rule source #}
{# Only checks with something to act on get a card; clear checks are named once below, their rules stay in Method. #}
{% set quiet = checks|reject("detailed")|list %}
<section class="s" id="details"><h2>Details</h2><p class="intro">The checks that need action, with their figures, breakdowns and the evidence (file and line) they are based on.</p>
{% for g, cs in groups %}
{% set shown = cs|select("detailed")|list %}
{% if shown %}
<div class="ghead">{{ icon(g.icon) }}{{ g.title }}</div>
<div class="grid">
{% for c in shown %}{{ m.card(c) }}{% endfor %}
</div>
{% endif %}
{% endfor %}
{% if quiet %}
<p class="note quiet">{{ icon("circle-check") }} Not shown, because no rule matched: {% for c in quiet %}<a href="#m-{{ c.id }}">{{ c.title }}</a>{{ ", " if not loop.last }}{% endfor %}. Their rules are listed under <a href="#method">Method and rules</a>.</p>
{% endif %}
</section>
